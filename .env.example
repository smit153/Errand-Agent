# Copy to .env and set a password. .env is git-ignored; never commit real values.
ERRAND_DB_HOST=127.0.0.1
ERRAND_DB_PORT=5433
ERRAND_DB_NAME=errand
ERRAND_DB_USER=errand
ERRAND_DB_PASSWORD=change-me
# Tests create/drop this database on the same server.
ERRAND_TEST_DB_NAME=errand_test
ERRAND_TIMEZONE=Asia/Kolkata
ERRAND_MOCK_SEED=42
# Optional package index override (installs are hash-pinned, so a mirror cannot substitute files).
# PIP_INDEX_URL=https://pypi.org/simple
# UV_DEFAULT_INDEX=https://pypi.org/simple
# Real-model backend: your ModelMux gateway (DECISIONS §17). Provider: claude or codex.
ERRAND_MODELMUX_PROVIDER=claude
# ERRAND_MODELMUX_MODEL=sonnet
# ERRAND_MODELMUX_URL=http://127.0.0.1:8101/v1
# Gateway key: the MODELMUX_API_KEY value in ~/.config/modelmux/secrets.env. Never commit it.
# scripts/smoke.sh reads it from there, so you normally don't need to set it here.
# ERRAND_MODELMUX_API_KEY=
